# ============================================================
# Copie este arquivo para ".env" (local) OU cole cada valor
# como variavel de ambiente separada no painel do Railway.
# NUNCA suba um arquivo .env de verdade para o GitHub.
# ============================================================

# --- API do GymBot / flw.chat ---
# Gerado em: Ajustes > Integracoes > Integracao via API
FLWCHAT_API_TOKEN=pn_coloque_seu_token_aqui
FLWCHAT_API_BASE_URL=https://api.wts.chat/core

# Segredo opcional para validar que o webhook realmente veio do GymBot
# (se o GymBot oferecer essa opcao ao criar a assinatura de webhook)
FLWCHAT_WEBHOOK_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui
CLAUDE_MODEL=claude-sonnet-4-5

# --- Google Sheets (conta de servico) ---
# Cole aqui o CONTEUDO INTEIRO do arquivo JSON baixado do Google Cloud
# (a chave da conta de servico), em uma linica linha.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# IDs das 5 planilhas (ja preenchidos com os IDs criados no projeto;
# so mude se recriar as planilhas)
SHEET_LEADS_ID=1zpDKedEppvLOtYrUuQbYVCKtmnVJbc5CQpDlev6RXUQ
SHEET_ATENDIMENTOS_ID=1i1Qj2CHV_NxZtconzuKqeZFvxNxlgnreksKlUzkuQ0A
SHEET_CONVERSOES_ID=1FHjPUryN0v4FsgPGjgGP9kQ7Zxhlb0Nl4AJVUbP5d-k
SHEET_AVALIACOES_ID=1SuD3YISI1kR06dipR18mngQ-oaZU1jF070ahaHLTYlc
SHEET_SINTESES_ID=1TCj0DaSpkopKSPI4NB6cqvhBR7BWxeyaZ3QF7bPIxpY

# --- Evolution API (instancia dedicada da agencia) ---
EVOLUTION_API_URL=https://sua-instancia-evolution.up.railway.app
EVOLUTION_INSTANCE=agente-supervisao-academias
EVOLUTION_API_KEY=coloque_sua_api_key_aqui

# JIDs dos grupos de destino (ja confirmados)
EVOLUTION_GROUP_GRECO_FORMA=559181115031-1434413359@g.us
EVOLUTION_GROUP_FITCOM=559181034279-1482354465@g.us

# --- Comportamento do agente ---
# Porta HTTP do servico (Railway define PORT automaticamente, pode deixar)
PORT=3000

# Fuso horario usado para horarios de relatorio e "dia" de referencia
TIMEZONE=America/Sao_Paulo

# Janela (em dias) que a varredura de reconciliacao revisita
# atendimentos ainda pendentes de classificacao
RECONCILIATION_LOOKBACK_DAYS=60

# Categoria de classificacao que representa "Objetivo atingido" no GymBot.
# IMPORTANTE: confirmar o valor real assim que virmos uma sessao classificada
# de verdade (ver README, secao "Calibracao pendente").
CLASSIFICATION_SUCCESS_CATEGORY=OBJECTIVE_ACHIEVED
